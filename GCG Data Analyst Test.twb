      <column caption='ARPPU' datatype='real' name='[Calculation_0864554885345285]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_revenue])/sum([paying_users])' />
      </column>
      <column caption='ARPDAU' datatype='real' name='[Calculation_0864554885677062]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_revenue])/SUM([dau])' />
      </column>
      <column caption='Sessions/DAU' datatype='real' name='[Calculation_0864554886365191]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_sessions])/SUM([dau])' />
      </column>
      <column caption='battlewin %' datatype='real' name='[Calculation_0864554898583561]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_battle_wins])/sum([total_battles])' />
      </column>
      <column caption='Rev/Trnx' datatype='real' name='[Calculation_0864554900463626]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([iap_revenue])/sum([iap_transactions])' />
      </column>
